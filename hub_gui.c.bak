  char artist[MAX_SONG_TITLE];
  char filepath[MAX_PATH_LENGTH];
  char art_path[MAX_PATH_LENGTH];
} SearchResult;

typedef struct {
  SDL_Color bg;
  SDL_Color top_bar;
  SDL_Color accent;
  SDL_Color target_accent;
  SDL_Color text_main;
  SDL_Color text_dim;
} HubTheme;

typedef struct {
  float x, y, w, h;
  float target_x, target_y;
  float target_w, target_h;
  int stage; // 1: Full, 2: Medium, 3: Small
  bool is_resizing;
  bool is_dragging;
  float drag_off_x, drag_off_y;
  void (*render)(SDL_Renderer *ren, int x, int y, int w, int h, int mx, int my);
  bool active;

  // Physics for sway
  float rotation;
  float target_rotation;
} HubWidget;

typedef struct {
  char path[MAX_PATH_LENGTH];
  SDL_Texture *sharp;
  SDL_Texture *blurred;
} ArtCache;

